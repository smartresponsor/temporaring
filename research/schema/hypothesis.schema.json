{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartresponsor.local/temporaring/hypothesis.schema.json",
  "title": "System Tempo Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "title", "system", "assumptions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_variables", "parameters", "base_vector_field", "tempo_factors"],
      "properties": {
        "state_variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "base_vector_field": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "tempo_factors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smooth", "finite_dimensional", "tempo_positive"],
      "properties": {
        "smooth": {"type": "boolean"},
        "finite_dimensional": {"type": "boolean"},
        "tempo_positive": {"type": "boolean"}
      }
    }
  }
}
