/vendor/
/var/
/node_modules/
/test-results/
/playwright-report/
/python/.venv/
/python/.pytest_cache/
/python/**/__pycache__/
/python/**/*.egg-info/
/config/reference.php

# Gating consumer surface: keep repository policy/profile, ignore vendored runtime snapshots.
/.gating/*
!/.gating/config/
!/.gating/config/**
!/.gating/profile/
/.gating/profile/*
!/.gating/profile/component/
/.gating/profile/component/*
!/.gating/profile/component/temporaring.yaml
/artifacts/*
!/artifacts/.gitkeep
/.phpunit.cache/
.env.local
.env.test.local
/.idea/
/.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
