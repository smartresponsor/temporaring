{
  "name": "temporaring/tempo",
  "description": "Temporaring component and System Tempo research orchestration runtime.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/error-handler": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/process": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.5",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.95.4",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "symfony/phpunit-bridge": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Temporaring\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Temporaring\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint:php": "php -l src/Kernel.php && php -l src/TemporaringBundle.php && php -l bin/console && php -l public/index.php",
    "lint:yaml": "php bin/console lint:yaml config --parse-tags",
    "lint:container": "php bin/console lint:container",
    "phpstan": "phpstan analyse src tests --level=8 --memory-limit=1G",
    "gating": "gating check --target=.",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --configuration phpunit.xml.dist --path-coverage --coverage-text=var/coverage/summary.txt"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "repositories": [
    {"type": "path", "url": "../Gating", "options": {"symlink": true, "versions": {"gating/gate": "dev-master"}}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true, "versions": {"cruding/crud": "dev-master"}}},
    {"type": "path", "url": "../Collectioning", "options": {"symlink": true, "versions": {"collectioning/collection": "dev-master"}}},
    {"type": "path", "url": "../Tabling", "options": {"symlink": true, "versions": {"tabling/table": "dev-master"}}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true, "versions": {"viewing/view": "dev-master"}}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true, "versions": {"objecting/object": "dev-master"}}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true, "versions": {"interfacing/interface": "dev-master"}}}
  ]
}
